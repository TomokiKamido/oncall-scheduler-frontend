rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者のみ読み書き
    match /admin_only/{document=**} {
      allow read, write: if request.auth.token.role == 'admin';
    }

    // 管理者と所属長は書き込み可、スタッフは読み取りのみ
    match /manager_area/{document=**} {
      allow write: if request.auth.token.role in ['admin', 'manager'];
      allow read: if request.auth != null;
    }

    // 全員閲覧可
    match /public/{document=**} {
      allow read: if true;
    }

    // ユーザーコレクション - 認証済みユーザーは読み取り可、管理者は書き込み可
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role == 'admin' || request.auth.uid == userId;
    }

    // ロール申請コレクション - 認証済みユーザーは読み書き可
    match /roleRequests/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 部署コレクション - 認証済みユーザーは読み取り可、管理者は書き込み可
    match /departments/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role == 'admin';
    }

    // スタッフコレクション - 認証済みユーザーは読み取り可、管理者とマネージャーは書き込み可
    match /staff/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }

    // スケジュールコレクション - 認証済みユーザーは読み取り可、管理者とマネージャーは書き込み可
    match /schedules/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
  }
}
