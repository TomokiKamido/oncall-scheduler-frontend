{
  "name": "oncall-scheduler-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "NODE_OPTIONS='--openssl-legacy-provider' craco start",
    "start:no-reload": "FAST_REFRESH=false NODE_OPTIONS='--openssl-legacy-provider' craco start",
    "build": "craco build",
    "build:serve": "npm run build && npx serve -s build -l 3002",
    "preview": "npm run build && npx serve -s build -l 3002",
    "test": "craco test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "prepare": "husky install",
    "firebase": "npx firebase --token $FIREBASE_TOKEN",
    "firebase:deploy": "npm run build && npx firebase deploy --token $FIREBASE_TOKEN",
    "firebase:serve": "npm run build && npx firebase serve --token $FIREBASE_TOKEN"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.1.2",
    "axios": "^0.27.2",
    "date-fns": "^2.29.3",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "lucide-react": "^0.263.1",
    "react": "^17.0.2",
    "react-dnd": "^14.0.5",
    "react-dnd-html5-backend": "^14.1.0",
    "react-dom": "^17.0.2",
    "react-firebase-hooks": "^5.1.1",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "swr": "^2.3.3",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@types/node": "^16.18.34",
    "@types/react": "^17.0.2",
    "@types/react-dom": "^17.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.45.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react": "^7.33.0",
    "firebase-tools": "^14.7.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "serve": "^14.2.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "git add"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "description": "このプロジェクトは、当直割作成ソフトのフロントエンド部分を実装したものです。Reactを使用して構築されており、スケジュール管理やスタッフ管理の機能を提供します。",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
